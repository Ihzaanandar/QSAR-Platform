# ==============================================================================
# QSAR Platform - Environment Variables Template
# ==============================================================================

# --- Frontend Configuration (Vercel / Local) ---
# If running locally with the full-stack server (server.ts), leave empty or set to http://localhost:3000.
# When deploying to Vercel, set this to your deployed Railway backend URL (e.g. https://your-backend.up.railway.app).
VITE_API_URL=

# --- Backend Configuration (Railway / Local FastAPI) ---
PORT=3000
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./data/uploads
QSAR_ARTIFACTS_DIR=./idh1_qsar_artifacts

# CORS Configuration for FastAPI (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://*.vercel.app
